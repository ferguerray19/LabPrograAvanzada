# ---------------------------------------------------------------------------
# Dataset crudo. NO se versiona.
#
# Son ~1,9 GB. GitHub rechaza archivos sobre 100 MB, y aunque los aceptara, un
# solo commit con el dataset deja el historial del repositorio inutilizable
# para siempre: `git clone` pasa a descargar ese peso en cada copia, y borrarlo
# despues no lo saca del historial sin reescribirlo entero.
#
# Este bloque tiene que estar desde el PRIMER commit.
# ---------------------------------------------------------------------------
data/raw/*
!data/raw/.gitkeep
data/bench_tmp/
*.jsonl

# Excepcion: la muestra de 50.000 eventos SI se versiona (9 MB).
!data/muestra/
!data/muestra/*.jsonl

# Salidas de la campana de mediciones: los CSV crudos SI se versionan,
# porque son la evidencia del informe. Las figuras se regeneran.
docs/figuras/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.ipynb_checkpoints/

# Perfiles de cProfile
*.prof

# Parametros locales de Docker Compose (se versiona .env.example)
.env

# Evidencias generadas por los scripts de lab/ (se capturan para el informe)
# Se conservan las evidencias del informe Docker.

# Sistema operativo y editores
.DS_Store
Thumbs.db
.idea/
.vscode/

# Datos reproducibles y archivos auxiliares locales
*.crc
lab_fs2/data/raw/*
!lab_fs2/data/raw/.gitkeep
!lab_fs2/data/raw/manifiesto_receptor.json
!lab_fs2/historico/data_raw/*.jsonl
lab_fs2/salida_fase2/bronze_raw.parquet/
